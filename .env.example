# DGX Endpoints (vLLM OpenAI-compatible API)
DGX_BASE_URL=http://localhost:8000
DGX_API_KEY=dummy-key-for-local-dgx

# Claude API Fallback (cheap model for cost efficiency)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Whisper Transcription Endpoint
WHISPER_ENDPOINT=/v1/audio/transcriptions
WHISPER_MODEL=whisper-1

# Semantic LLM Endpoint  
SEMANTIC_LLM_ENDPOINT=/v1/chat/completions
SEMANTIC_LLM_MODEL=your-model-name

# Timeouts (seconds)
DGX_TIMEOUT=30
CLAUDE_TIMEOUT=60

# State Directories
STATE_DIR=./state
SPECS_DIR=./specs
RECORDINGS_DIR=./recordings

# OneDrive path (for file watcher)
ONEDRIVE_RECORDINGS_PATH=/path/to/OneDrive/Chat2Plan/recordings

# Audio Recording
AUDIO_SAMPLE_RATE=16000
AUDIO_FORMAT=wav

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8001
